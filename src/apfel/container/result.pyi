from collections.abc import Callable
from typing import Any, Self, overload, override

from apfel.container.maybe import Maybe
from apfel.core.monad import Monad

class Result[T, E = Any](Monad[T]):
    __slots__ = ("_value", "_is_ok")
    def __init__(self, value: T, /, *, is_ok: bool = True): ...
    @classmethod
    def make_ok(cls, val: T, /) -> Result[T, E]: ...
    @classmethod
    def make_err(cls, val: E, /) -> Result[T, E]: ...
    def and_(self, other: Self) -> Self: ...
    def __and__(self, other: Self) -> Self: ...
    def and_then[U](self, f: Callable[[T], Result[U, E]], /) -> Result[U, E]: ...
    @override
    def apply[U](self, f: Result[Callable[[T], U], E]) -> Result[U, E]: ...
    @override
    def bind[U](self, f: Callable[[T], Result[U, E]], /) -> Result[U, E]: ...
    def __bool__(self) -> bool: ...
    def done(self) -> tuple[T, None] | tuple[None, E]: ...
    def __eq__(self, other: Self) -> bool: ...
    def err(self) -> Maybe[E]: ...
    def expect(self, msg: str, /) -> T: ...
    def expect_err(self, msg: str, /) -> E: ...
    def flatten[T_](self: Result[Result[T_, E], E]) -> Result[T_, E]: ...
    def __hash__(self) -> int: ...
    def is_err(self) -> bool: ...
    def is_err_and(self, f: Callable[[E], bool], /) -> bool: ...
    def is_ok(self) -> bool: ...
    def is_ok_and(self, f: Callable[[T], bool], /) -> bool: ...
    @override
    def map[U](self, f: Callable[[T], U], /) -> Result[U, E]: ...
    def map_err[F](self, f: Callable[[E], F], /) -> Result[T, F]: ...
    def map_or[U](self, default: U, f: Callable[[T], U], /) -> U: ...
    def map_or_else[U](
        self, default: Callable[[E], U], f: Callable[[T], U], /
    ) -> U: ...
    def ok(self) -> Maybe[T]: ...
    def or_(self, other: Self) -> Self: ...
    def __or__(self, other: Self) -> Self: ...
    def or_else(self, f: Callable[[E], Self], /) -> Self: ...
    @override
    @classmethod
    def pure(cls, val: T, /) -> Result[T, E]: ...
    def tap(self, f: Callable[[T], Any], /) -> Self: ...
    def tap_err(self, f: Callable[[E], Any], /) -> Self: ...
    def throw(self) -> T: ...
    def transpose[U](self: Result[Maybe[U], E]) -> Maybe[Result[U, E]]: ...
    def unwrap(self) -> T: ...
    def unwrap_err(self) -> E: ...
    def unwrap_or(self, default: T, /) -> T: ...
    def unwrap_or_else(self, f: Callable[[E], T], /) -> T: ...
    def unwrap_unchecked(self) -> T: ...
    def unwrap_err_unchecked(self) -> E: ...

class ok[E]:
    def __new__[T](cls, val: T, /) -> Result[T, E]: ...

class err[T]:
    def __new__[E](cls, val: E, /) -> Result[T, E]: ...

class caught[E = Exception, T = Any]:
    def __class_getitem__[F](cls, item: type[F]) -> type[caught[F, T]]: ...
    @overload
    def __new__[U, **P](
        cls, /
    ) -> Callable[[Callable[P, U]], Callable[P, Result[U, E]]]: ...
    @overload
    def __new__[U, F, **P](
        cls, exception: type[F], /
    ) -> Callable[[Callable[P, U]], Callable[P, Result[U, F]]]: ...
    @overload
    def __new__[U, E0, Es, **P](
        cls,
        exception: type[E0],
        /,
        *exceptions: type[Es],
    ) -> Callable[[Callable[P, U]], Callable[P, Result[U, E0 | Es]]]: ...
    @overload
    def __new__[U, **P](cls, func: Callable[P, U], /) -> Callable[P, Result[U, E]]: ...
